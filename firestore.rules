rules_version = '2';

// ProDefact Firestore security rules.
//
// Everything lives under users/{uid}/... — a user may only read or
// write their own data, and only while authenticated. There is no
// broad/public read or write path anywhere in this ruleset.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read, write: if isOwner();

      match /inspections/{inspectionId} {
        allow read, write: if isOwner();

        match /sections/{sectionId} {
          allow read, write: if isOwner();
        }

        match /findings/{findingId} {
          allow read, write: if isOwner();

          match /evidence/{evidenceId} {
            allow read, write: if isOwner();
          }
        }
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
