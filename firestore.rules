rules_version = '2';

// ProDefact Firestore security rules.
//
// Everything lives under users/{uid}/... — a user may only read or
// write their own data, and only while authenticated. There is no
// broad/public read or write path anywhere in this ruleset.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read, write: if isOwner();

      match /inspections/{inspectionId} {
        allow read, write: if isOwner();

        match /sections/{sectionId} {
          allow read, write: if isOwner();
        }

        // AI results and the inspector's decisions on them. Pushed by
        // the app's sync (and deleted with their finding); without this
        // rule the default deny rejected every AI-suggestion push.
        match /aiSuggestions/{suggestionId} {
          allow read, write: if isOwner();
        }

        match /findings/{findingId} {
          allow read, write: if isOwner();

          match /evidence/{evidenceId} {
            allow read, write: if isOwner();
          }
        }
      }

      // The company's own custom defect catalogue — owner-only, never
      // shared with any other account and never part of the master
      // catalogue.
      match /customCatalogue/{entryId} {
        allow read, write: if isOwner();
      }

      // Commercial/billing data — the Credits ledger, cached wallet
      // balance, House Passes, payment intents, and AI job records are
      // all backend-authoritative (see docs/commercial_model.md,
      // "Wallet security"). The client may read its own data for
      // display, but every write happens only via the Admin SDK inside
      // a Cloud Function callable, which bypasses these rules entirely
      // — a direct client write here is always denied, with no
      // exception, so Flutter can never grant itself Credits, edit its
      // balance, activate a House Pass, or alter a ledger entry.
      match /wallet/{docId} {
        allow read: if isOwner();
        allow write: if false;
      }

      match /walletTransactions/{transactionId} {
        allow read: if isOwner();
        allow write: if false;
      }

      match /housePasses/{passId} {
        allow read: if isOwner();
        allow write: if false;
      }

      match /paymentIntents/{intentId} {
        allow read: if isOwner();
        allow write: if false;
      }

      match /aiJobs/{jobId} {
        allow read: if isOwner();
        allow write: if false;
      }
    }

    // The single, centralized, server-side pricing configuration (see
    // billing/pricing_config.ts) — never read directly by the client
    // (every price Flutter shows comes from a callable, e.g.
    // `getCommercialConfig`, which returns only the customer-safe
    // subset) and never writable by any client under any circumstance.
    match /pricing/{document} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
